{
  "name": "fast-dashboard-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "React task dashboard with a local JSON API",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server.js",
    "test": "node --test",
    "coverage": "c8 --all --include=server.js --reporter=text --reporter=lcov node --test",
    "coverage:check": "c8 --all --include=server.js --reporter=text --check-coverage --lines=100 --functions=100 --branches=100 --statements=100 node --test"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0"
  }
}
